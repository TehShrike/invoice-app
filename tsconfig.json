{
  "include": ["./landing-page/**/*.ts", "./landing-page/**/*.svelte", "./shared/**/*.ts", "./shared/**/*.svelte"],
  "exclude": ["node_modules/**", "public/**"],
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "types": ["svelte"],

    "sourceMap": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
