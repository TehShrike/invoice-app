{
  "name": "invoice-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prepare": "symlink shared node_modules/shared",
    "test:types": "tsc --noEmit",
    "test:svelte": "svelte-check --threshold=warning --workspace=.",
    "test": "run-p test:**",
    "serve": "dead-server --no-css-inject --no-browser public",
    "build": "npm run prepare && node build.ts",
    "watch": "npm run prepare && node build.ts --watch",
    "dev": "run-p watch serve",
    "postinstall": "npm run prepare"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TehShrike/invoice-app.git"
  },
  "author": "TehShrike",
  "license": "WTFPL",
  "bugs": {
    "url": "https://github.com/TehShrike/invoice-app/issues"
  },
  "homepage": "https://github.com/TehShrike/invoice-app#readme",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "dead-server": "^1.0.9",
    "esbuild": "^0.27.0",
    "esbuild-svelte": "^0.9.3",
    "financial-number": "^4.0.2",
    "svelte": "^5",
    "svelte-check": "^4.3.4",
    "symlink-cli": "^1.0.0",
    "typescript": "^5.7.2",
    "warg": "^2.1.1"
  }
}
